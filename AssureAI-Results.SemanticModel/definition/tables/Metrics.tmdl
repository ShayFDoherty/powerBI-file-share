table Metrics
	lineageTag: 48befe2d-158e-556a-8f80-e130fa4e0715

	/// Sub-metrics that met their threshold.
	measure 'Metrics passed' = CALCULATE(COUNTROWS(Metrics), Metrics[status] = "passed")
		formatString: 0
		lineageTag: 99b090e1-782b-512a-a88c-b5aa9d82eca9

	/// Sub-metrics that missed their threshold.
	measure 'Metrics failed' = CALCULATE(COUNTROWS(Metrics), Metrics[status] = "failed")
		formatString: 0
		lineageTag: bda412f7-4966-5ee3-8026-47c72bbc303a

	/// Passed over judged; metrics that errored are in neither.
	measure 'Pass rate' = DIVIDE([Metrics passed], [Metrics passed] + [Metrics failed])
		formatString: 0.0%
		lineageTag: 8cc88b3c-f686-5ae1-a1c3-818131873f7d

