	partition Metrics = m
		mode: import
		source =
				let
				    Source = Table.SelectColumns(fnAssureAIFeed("results/metrics"), {"workspace_id", "run_id", "run_name", "use_case_id", "use_case_title", "finished_at", "pillar", "metric_name", "value", "threshold", "comparison", "status", "reason"}, MissingField.UseNull),
				    Typed = Table.TransformColumnTypes(Source, {{"workspace_id", type text}, {"run_id", type text}, {"run_name", type text}, {"use_case_id", type text}, {"use_case_title", type text}, {"finished_at", type datetimezone}, {"pillar", type text}, {"metric_name", type text}, {"value", type number}, {"threshold", type number}, {"comparison", type text}, {"status", type text}, {"reason", type text}}),
				    Utc = Table.TransformColumns(Typed, {{"finished_at", DateTimeZone.RemoveZone, type datetime}}),
				    Add_run_pillar_key = Table.AddColumn(Utc, "run_pillar_key", each [run_id] & "|" & [pillar], type text)
				in
				    Add_run_pillar_key

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

