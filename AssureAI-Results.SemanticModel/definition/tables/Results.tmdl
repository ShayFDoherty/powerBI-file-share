	partition Results = m
		mode: import
		source =
				let
				    Source = Table.SelectColumns(fnAssureAIFeed("results"), {"workspace_id", "run_id", "run_name", "use_case_id", "use_case_title", "finished_at", "pillar", "model", "provider", "status", "created_at", "state", "tier", "mean", "percentage", "score", "reason", "cost_total", "currency", "overall_tier", "overall_percentage", "not_production_ready"}, MissingField.UseNull),
				    Typed = Table.TransformColumnTypes(Source, {{"workspace_id", type text}, {"run_id", type text}, {"run_name", type text}, {"use_case_id", type text}, {"use_case_title", type text}, {"finished_at", type datetimezone}, {"pillar", type text}, {"model", type text}, {"provider", type text}, {"status", type text}, {"created_at", type datetimezone}, {"state", type text}, {"tier", type text}, {"mean", type number}, {"percentage", type number}, {"score", type number}, {"reason", type text}, {"cost_total", type number}, {"currency", type text}, {"overall_tier", type text}, {"overall_percentage", type number}, {"not_production_ready", type logical}}),
				    Utc = Table.TransformColumns(Typed, {{"finished_at", DateTimeZone.RemoveZone, type datetime}, {"created_at", DateTimeZone.RemoveZone, type datetime}}),
				    Add_run_pillar_key = Table.AddColumn(Utc, "run_pillar_key", each [run_id] & "|" & [pillar], type text),
				    Add_tier_rank = Table.AddColumn(Add_run_pillar_key, "tier_rank", each if [tier] = "not_production_ready" then 0 else if [tier] = "bronze" then 1 else if [tier] = "silver" then 2 else if [tier] = "gold" then 3 else null, Int64.Type)
				in
				    Add_tier_rank

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

