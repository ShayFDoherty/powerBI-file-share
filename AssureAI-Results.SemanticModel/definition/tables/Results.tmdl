table Results
	lineageTag: ecfbfe5d-dc70-5167-b6c1-31ab7fe2a28f

	/// Finished runs.
	measure Runs = DISTINCTCOUNT(Results[run_id])
		formatString: 0
		lineageTag: 4d26f935-4624-52ba-8abe-6b8dec9e141d

	/// AI use cases with at least one finished run.
	measure 'Use cases' = DISTINCTCOUNTNOBLANK(Results[use_case_id])
		formatString: 0
		lineageTag: eef3679f-8490-55d2-93b9-0f7a309bf1ed

	/// Provider cost as priced when each run finished. Blank means unknown, not free.
	measure 'Total cost' = SUM(Results[cost_total])
		formatString: #,0.00
		lineageTag: 82938dc0-0fe7-577f-a803-bb358b3333a3

	/// Mean of the pillars' anchored percentages; pillars with no score are left out.
	measure 'Average pillar %' = AVERAGE(Results[percentage])
		formatString: 0.0
		lineageTag: 2e128a12-2cce-5ce0-afa9-6a0f8ffe70a6

	/// Runs where a gated pillar is Not Production Ready.
	measure 'Runs not production ready' = COALESCE(CALCULATE(DISTINCTCOUNT(Results[run_id]), Results[not_production_ready] = TRUE()), 0)
		formatString: 0
		lineageTag: 89cbeee2-7048-5deb-b564-53934d0369d2

